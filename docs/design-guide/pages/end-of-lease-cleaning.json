  "__file": "wp_block",
  "title": "Prime — End Of Lease Cleaning",
  "content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#e8f4ef\"},\"spacing\":{\"padding\":{\"top\":\"52px\",\"right\":\"22px\",\"bottom\":\"52px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#e8f4ef;margin-top:0;margin-bottom:0;padding-top:52px;padding-right:22px;padding-bottom:52px;padding-left:22px\"><!-- wp:columns {\"verticalAlignment\":\"center\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"16px\",\"left\":\"36px\"}}}} -->\n<div class=\"wp-block-columns are-vertically-aligned-center\"><!-- wp:column {\"width\":\"55%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:55%\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"12px\",\"fontWeight\":\"700\",\"letterSpacing\":\"1.5px\"},\"color\":{\"text\":\"#086762\"}}} -->\n<p class=\"has-text-color\" style=\"color:#086762;font-size:12px;font-weight:700;letter-spacing:1.5px\">OUR SERVICES / END OF LEASE CLEANING</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h1 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">End of lease cleaning in Malvern East</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Moving is stressful enough. Let us handle the oven, the shower screen and that mystery mark behind the fridge.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"style\":{\"spacing\":{\"blockGap\":\"9px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"#086762\",\"text\":\"#ffffff\"},\"border\":{\"radius\":\"6px\",\"width\":\"1px\",\"color\":\"#086762\"},\"spacing\":{\"padding\":{\"top\":\"12px\",\"right\":\"18px\",\"bottom\":\"12px\",\"left\":\"18px\"}},\"typography\":{\"fontWeight\":\"600\",\"fontSize\":\"15px\"}}} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-text-color has-background has-border-color has-custom-font-size wp-element-button\" href=\"/staging/prices/?prime_service=End+of+lease+cleaning#estimate\" style=\"border-color:#086762;border-width:1px;border-radius:6px;color:#ffffff;background-color:#086762;padding-top:12px;padding-right:18px;padding-bottom:12px;padding-left:18px;font-size:15px;font-weight:600\">Get my end of lease estimate</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"45%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:45%\"><!-- wp:image {\"id\":65,\"aspectRatio\":\"1.64\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"style\":{\"border\":{\"radius\":\"10px\",\"width\":\"0px\"}}} -->\n<figure class=\"wp-block-image size-full has-custom-border\"><img src=\"https://primedomestic.com.au/staging/wp-content/uploads/2026/11/end-of-lease-cleaning.jpg\" alt=\"An empty home with polished floors and glass doors.\" class=\"wp-image-65\" style=\"border-width:0px;border-radius:10px;aspect-ratio:1.64;object-fit:cover\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#faf7ee\"},\"spacing\":{\"padding\":{\"top\":\"44px\",\"right\":\"22px\",\"bottom\":\"44px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#faf7ee;margin-top:0;margin-bottom:0;padding-top:44px;padding-right:22px;padding-bottom:44px;padding-left:22px\"><!-- wp:heading {\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h2 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Ready for the final inspection?</h2>\n<!-- /wp:heading -->\n\n<!-- wp:columns {\"verticalAlignment\":\"top\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"16px\",\"left\":\"20px\"}}}} -->\n<div class=\"wp-block-columns are-vertically-aligned-top\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#ffffff\"},\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"20px\",\"right\":\"20px\",\"bottom\":\"20px\",\"left\":\"20px\"},\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-group has-border-color has-background\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;background-color:#ffffff;padding-top:20px;padding-right:20px;padding-bottom:20px;padding-left:20px\"><!-- wp:heading {\"level\":3,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h3 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Empty home</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Standard estimates apply to unfurnished homes.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#ffffff\"},\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"20px\",\"right\":\"20px\",\"bottom\":\"20px\",\"left\":\"20px\"},\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-group has-border-color has-background\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;background-color:#ffffff;padding-top:20px;padding-right:20px;padding-bottom:20px;padding-left:20px\"><!-- wp:heading {\"level\":3,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h3 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Furniture still inside?</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Send the property details for an individual quote.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#ffffff\"},\"spacing\":{\"padding\":{\"top\":\"44px\",\"right\":\"22px\",\"bottom\":\"44px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#ffffff;margin-top:0;margin-bottom:0;padding-top:44px;padding-right:22px;padding-bottom:44px;padding-left:22px\"><!-- wp:heading {\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h2 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">What’s included</h2>\n<!-- /wp:heading -->\n\n<!-- wp:columns {\"verticalAlignment\":\"top\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"16px\",\"left\":\"20px\"}}}} -->\n<div class=\"wp-block-columns are-vertically-aligned-top\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#ffffff\"},\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"20px\",\"right\":\"20px\",\"bottom\":\"20px\",\"left\":\"20px\"},\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-group has-border-color has-background\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;background-color:#ffffff;padding-top:20px;padding-right:20px;padding-bottom:20px;padding-left:20px\"><!-- wp:heading {\"level\":3,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h3 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Kitchen</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Benchtops, sink, stovetop and inside empty cupboards.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#ffffff\"},\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"20px\",\"right\":\"20px\",\"bottom\":\"20px\",\"left\":\"20px\"},\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-group has-border-color has-background\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;background-color:#ffffff;padding-top:20px;padding-right:20px;padding-bottom:20px;padding-left:20px\"><!-- wp:heading {\"level\":3,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h3 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Bathrooms</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Shower, bath, toilet, vanity and mirrors.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:columns {\"verticalAlignment\":\"top\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"16px\",\"left\":\"20px\"}}}} -->\n<div class=\"wp-block-columns are-vertically-aligned-top\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#ffffff\"},\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"20px\",\"right\":\"20px\",\"bottom\":\"20px\",\"left\":\"20px\"},\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-group has-border-color has-background\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;background-color:#ffffff;padding-top:20px;padding-right:20px;padding-bottom:20px;padding-left:20px\"><!-- wp:heading {\"level\":3,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h3 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Living areas</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Skirting boards, doors, sills and reachable inside windows.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#ffffff\"},\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"20px\",\"right\":\"20px\",\"bottom\":\"20px\",\"left\":\"20px\"},\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-group has-border-color has-background\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;background-color:#ffffff;padding-top:20px;padding-right:20px;padding-bottom:20px;padding-left:20px\"><!-- wp:heading {\"level\":3,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h3 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Floors</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Vacuum and mop hard floors. Carpet steam is an add-on.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#faf7ee\"},\"spacing\":{\"padding\":{\"top\":\"44px\",\"right\":\"22px\",\"bottom\":\"44px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#faf7ee;margin-top:0;margin-bottom:0;padding-top:44px;padding-right:22px;padding-bottom:44px;padding-left:22px\"><!-- wp:heading {\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h2 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Outside this service</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>High-reach or ladder work, grout restoration and heavy mould removal. Oven and carpet steam cleaning are optional extras.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#ffffff\"},\"spacing\":{\"padding\":{\"top\":\"44px\",\"right\":\"22px\",\"bottom\":\"44px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#ffffff;margin-top:0;margin-bottom:0;padding-top:44px;padding-right:22px;padding-bottom:44px;padding-left:22px\"><!-- wp:heading {\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h2 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Frequently asked questions</h2>\n<!-- /wp:heading -->\n\n<!-- wp:details {\"showContent\":true,\"style\":{\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"14px\",\"right\":\"16px\",\"bottom\":\"14px\",\"left\":\"16px\"}}}} -->\n<details class=\"wp-block-details has-border-color\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;padding-top:14px;padding-right:16px;padding-bottom:14px;padding-left:16px\" open><summary>Should the home be empty?</summary><!-- wp:paragraph -->\n<p>Yes. If it is furnished, ask for a custom quote.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details {\"style\":{\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"14px\",\"right\":\"16px\",\"bottom\":\"14px\",\"left\":\"16px\"}}}} -->\n<details class=\"wp-block-details has-border-color\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;padding-top:14px;padding-right:16px;padding-bottom:14px;padding-left:16px\"><summary>Is oven cleaning included?</summary><!-- wp:paragraph -->\n<p>Oven cleaning is an optional extra.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details {\"style\":{\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"14px\",\"right\":\"16px\",\"bottom\":\"14px\",\"left\":\"16px\"}}}} -->\n<details class=\"wp-block-details has-border-color\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;padding-top:14px;padding-right:16px;padding-bottom:14px;padding-left:16px\"><summary>Can carpets be done on the same day?</summary><!-- wp:paragraph -->\n<p>Yes. Choose carpet steam cleaning as an add-on for the same visit.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details -->\n\n<!-- wp:details {\"style\":{\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"14px\",\"right\":\"16px\",\"bottom\":\"14px\",\"left\":\"16px\"}}}} -->\n<details class=\"wp-block-details has-border-color\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;padding-top:14px;padding-right:16px;padding-bottom:14px;padding-left:16px\"><summary>Is my bond guaranteed?</summary><!-- wp:paragraph -->\n<p>We clean to the agent’s checklist. The bond decision belongs to your agent.</p>\n<!-- /wp:paragraph --></details>\n<!-- /wp:details --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#104747\"},\"spacing\":{\"padding\":{\"top\":\"44px\",\"right\":\"22px\",\"bottom\":\"44px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#104747;margin-top:0;margin-bottom:0;padding-top:44px;padding-right:22px;padding-bottom:44px;padding-left:22px\"><!-- wp:heading {\"style\":{\"color\":{\"text\":\"#ffffff\"},\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h2 class=\"wp-block-heading has-text-color\" style=\"color:#ffffff;margin-top:12px;margin-bottom:12px\">Hand back the keys with confidence.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:buttons {\"style\":{\"spacing\":{\"blockGap\":\"9px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"#edce92\",\"text\":\"#143e40\"},\"border\":{\"radius\":\"6px\",\"width\":\"1px\",\"color\":\"#edce92\"},\"spacing\":{\"padding\":{\"top\":\"12px\",\"right\":\"18px\",\"bottom\":\"12px\",\"left\":\"18px\"}},\"typography\":{\"fontWeight\":\"600\",\"fontSize\":\"15px\"}}} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-text-color has-background has-border-color has-custom-font-size wp-element-button\" href=\"/staging/prices/?prime_service=End+of+lease+cleaning#estimate\" style=\"border-color:#edce92;border-width:1px;border-radius:6px;color:#143e40;background-color:#edce92;padding-top:12px;padding-right:18px;padding-bottom:12px;padding-left:18px;font-size:15px;font-weight:600\">Get my estimate</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"style\":{\"color\":{\"background\":\"#ffffff\",\"text\":\"#143e40\"},\"border\":{\"radius\":\"6px\",\"width\":\"1px\",\"color\":\"#ceded8\"},\"spacing\":{\"padding\":{\"top\":\"12px\",\"right\":\"18px\",\"bottom\":\"12px\",\"left\":\"18px\"}},\"typography\":{\"fontWeight\":\"600\",\"fontSize\":\"15px\"}}} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-text-color has-background has-border-color has-custom-font-size wp-element-button\" href=\"tel:+61491245156\" style=\"border-c