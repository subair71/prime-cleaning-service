  "title": "Prime — Blog",
  "content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#e8f4ef\"},\"spacing\":{\"padding\":{\"top\":\"52px\",\"right\":\"22px\",\"bottom\":\"52px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#e8f4ef;margin-top:0;margin-bottom:0;padding-top:52px;padding-right:22px;padding-bottom:52px;padding-left:22px\"><!-- wp:columns {\"verticalAlignment\":\"center\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"16px\",\"left\":\"36px\"}}}} -->\n<div class=\"wp-block-columns are-vertically-aligned-center\"><!-- wp:column {\"width\":\"55%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:55%\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"12px\",\"fontWeight\":\"700\",\"letterSpacing\":\"1.5px\"},\"color\":{\"text\":\"#086762\"}}} -->\n<p class=\"has-text-color\" style=\"color:#086762;font-size:12px;font-weight:700;letter-spacing:1.5px\">PRIME JOURNAL</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h1 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Tips from the cleaning cupboard</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Practical cleaning tips from a small Melbourne team. The things we wish everyone knew before inspection day.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"45%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:45%\"><!-- wp:image {\"id\":8,\"aspectRatio\":\"1.64\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"style\":{\"border\":{\"radius\":\"10px\",\"width\":\"0px\"}}} -->\n<figure class=\"wp-block-image size-full has-custom-border\"><img src=\"https://primedomestic.com.au/staging/wp-content/uploads/2026/11/prime-regular-1280.webp\" alt=\"A light-filled living room with a neutral sofa.\" class=\"wp-image-8\" style=\"border-width:0px;border-radius:10px;aspect-ratio:1.64;object-fit:cover\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#ffffff\"},\"spacing\":{\"padding\":{\"top\":\"44px\",\"right\":\"22px\",\"bottom\":\"44px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#ffffff;margin-top:0;margin-bottom:0;padding-top:44px;padding-right:22px;padding-bottom:44px;padding-left:22px\"><!-- wp:query {\"queryId\":1,\"query\":{\"perPage\":9,\"pages\":0,\"offset\":0,\"postType\":\"post\",\"order\":\"desc\",\"orderBy\":\"date\",\"sticky\":\"\",\"inherit\":false}} -->\n<div class=\"wp-block-query\"><!-- wp:post-template {\"layout\":{\"type\":\"grid\",\"columnCount\":3}} -->\n<!-- wp:post-featured-image {\"isLink\":true} /-->\n\n<!-- wp:post-terms {\"term\":\"category\"} /-->\n\n<!-- wp:post-title {\"isLink\":true} /-->\n\n<!-- wp:read-more {\"content\":\"Read article\"} /-->\n<!-- /wp:post-template -->\n\n<!-- wp:query-pagination -->\n<!-- wp:query-pagination-previous /-->\n\n<!-- wp:query-pagination-numbers /-->\n\n<!-- wp:query-pagination-next /-->\n<!-- /wp:query-pagination -->\n\n<!-- wp:query-no-results -->\n<!-- wp:heading {\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h2 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Our first tips are on the way</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>In the meantime, the oven isn’t going to clean itself.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"style\":{\"spacing\":{\"blockGap\":\"9px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"#ffffff\",\"text\":\"#143e40\"},\"border\":{\"radius\":\"6px\",\"width\":\"1px\",\"color\":\"#ceded8\"},\"spacing\":{\"padding\":{\"top\":\"12px\",\"right\":\"18px\",\"bottom\":\"12px\",\"left\":\"18px\"}},\"typography\":{\"fontWeight\":\"600\",\"fontSize\":\"15px\"}}} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-text-color has-background has-border-color has-custom-font-size wp-element-button\" href=\"/staging/prices/#estimate\" style=\"border-color:#ceded8;border-width:1px;border-radius:6px;color:#143e40;background-color:#ffffff;padding-top:12px;padding-right:18px;padding-bottom:12px;padding-left:18px;font-size:15px;font-weight:600\">Get my estimate</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n<!-- /wp:query-no-results --></div>\n<!-- /wp:query --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#104747\"},\"spacing\":{\"padding\":{\"top\":\"44px\",\"right\":\"22px\",\"bottom\":\"44px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#104747;margin-top:0;margin-bottom:0;padding-top:44px;padding-right:22px;padding-bottom:44px;padding-left:22px\"><!-- wp:heading {\"style\":{\"color\":{\"text\":\"#ffffff\"},\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h2 class=\"wp-block-heading has-text-color\" style=\"color:#ffffff;margin-top:12px;margin-bottom:12px\">Ready for a cleaner home?</h2>\n<!-- /wp:heading -->\n\n<!-- wp:buttons {\"style\":{\"spacing\":{\"blockGap\":\"9px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"#edce92\",\"text\":\"#143e40\"},\"border\":{\"radius\":\"6px\",\"width\":\"1px\",\"color\":\"#edce92\"},\"spacing\":{\"padding\":{\"top\":\"12px\",\"right\":\"18px\",\"bottom\":\"12px\",\"left\":\"18px\"}},\"typography\":{\"fontWeight\":\"600\",\"fontSize\":\"15px\"}}} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-text-color has-background has-border-color has-custom-font-size wp-element-button\" href=\"/staging/prices/#estimate\" style=\"border-color:#edce92;border-width:1px;border-radius:6px;color:#143e40;background-color:#edce92;padding-top:12px;padding-right:18px;padding-bottom:12px;padding-left:18px;font-size:15px;font-weight:600\">Get my estimate</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"style\":{\"color\":{\"background\":\"#ffffff\",\"text\":\"#143e40\"},\"border\":{\"radius\":\"6px\",\"width\":\"1px\",\"color\":\"#ceded8\"},\"spacing\":{\"padding\":{\"top\":\"12px\",\"right\":\"18px\",\"bottom\":\"12px\",\"left\":\"18px\"}},\"typography\":{\"fontWeight\":\"600\",\"fontSize\":\"15px\"}}} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-text-color has-background has-border-color has-custom-font-size wp-element-button\" href=\"tel:+61491245156\" style=\"border-color:#ceded8;border-width:1px;border-radius:6px;color:#143e40;background-color:#ffffff;padding-top:12px;padding-right:18px;padding-bottom:12px;padding-left:18px;font-size:15px;font-weight:600\">Call us</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"style\":{\"color\":{\"background\":\"#ffffff\",\"text\":\"#143e40\"},\"border\":{\"radius\":\"6px\",\"width\":\"1px\",\"color\":\"#ceded8\"},\"spacing\":{\"padding\":{\"top\":\"12px\",\"right\":\"18px\",\"bottom\":\"12px\",\"left\":\"18px\"}},\"typography\":{\"fontWeight\":\"600\",\"fontSize\":\"15px\"}}} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-text-color has-background has-border-color has-custom-font-size wp-element-button\" href=\"https://wa.me/61491245156\" style=\"border-color:#ceded8;border-width:1px