/div>\n<!-- /wp:columns -->\n\n<!-- wp:columns {\"verticalAlignment\":\"top\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"16px\",\"left\":\"20px\"}}}} -->\n<div class=\"wp-block-columns are-vertically-aligned-top\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#ffffff\"},\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"20px\",\"right\":\"20px\",\"bottom\":\"20px\",\"left\":\"20px\"},\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-group has-border-color has-background\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;background-color:#ffffff;padding-top:20px;padding-right:20px;padding-bottom:20px;padding-left:20px\"><!-- wp:heading {\"level\":3,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h3 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Living areas</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Dust reachable surfaces. Vacuum and mop.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#ffffff\"},\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"20px\",\"right\":\"20px\",\"bottom\":\"20px\",\"left\":\"20px\"},\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-group has-border-color has-background\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;background-color:#ffffff;padding-top:20px;padding-right:20px;padding-bottom:20px;padding-left:20px\"><!-- wp:heading {\"level\":3,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h3 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Throughout</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Empty bins and wipe switches and door handles.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#faf7ee\"},\"spacing\":{\"padding\":{\"top\":\"44px\",\"right\":\"22px\",\"bottom\":\"44px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#faf7ee;margin-top:0;margin-bottom:0;padding-top:44px;padding-right:22px;padding-bottom:44px;padding-left:22px\"><!-- wp:heading {\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h2 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Outside this service</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>High ladder work, outside windows above ground level, heavy mould, rubbish removal and pest control.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#ffffff\"},\"spacing\":{\"padding\":{\"top\":\"44px\",\"right\":\"22px\",\"bottom\":\"44px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#ffffff;margin-top:0;margin-bottom:0;padding-top:44px;padding-right:22px;padding-bottom:44px;padding-left:22px\"><!-- wp:heading {\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h2 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Frequently asked questions</h2>\n<!-- /wp:heading -->\n\n<!-- wp:details {\"showContent\":true,\"style\":{\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":