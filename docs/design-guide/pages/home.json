column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#ffffff\"},\"spacing\":{\"padding\":{\"top\":\"44px\",\"right\":\"22px\",\"bottom\":\"44px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#ffffff;margin-top:0;margin-bottom:0;padding-top:44px;padding-right:22px;padding-bottom:44px;padding-left:22px\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"12px\",\"fontWeight\":\"700\",\"letterSpacing\":\"1.5px\"},\"color\":{\"text\":\"#086762\"}}} -->\n<p class=\"has-text-color\" style=\"color:#086762;font-size:12px;font-weight:700;letter-spacing:1.5px\">OUR SERVICES</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h2 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">What we clean</h2>\n<!-- /wp:heading -->\n\n<!-- wp:columns {\"verticalAlignment\":\"top\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"16px\",\"left\":\"20px\"}}}} -->\n<div class=\"wp-block-columns are-vertically-aligned-top\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#ffffff\"},\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"20px\",\"right\":\"20px\",\"bottom\":\"20px\",\"left\":\"20px\"},\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-group has-border-color has-background\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;background-color:#ffffff;padding-top:20px;padding-right:20px;padding-bottom:20px;padding-left:20px\"><!-- wp:image {\"id\":64,\"aspectRatio\":\"2.25\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"style\":{\"border\":{\"radius\":\"10px\",\"width\":\"0px\"}}} -->\n<figure class=\"wp-block-image size-full has-custom-border\"><img src=\"https://primedomestic.com.au/staging/wp-content/uploads/2026/11/regular-deep-cleaning.jpg\" alt=\"A sunlit living room with a sofa and houseplants.\" class=\"wp-image-64\" style=\"border-width:0px;border-radius:10px;aspect-ratio:2.25;object-fit:cover\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h3 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Regular &amp; deep cleaning</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Weekly, fortnightly or a one-off reset.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><a href=\"/staging/regular-house-cleaning/\">See what’s included →</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#ffffff\"},\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"20px\",\"right\":\"20px\",\"bottom\":\"20px\",\"left\":\"20px\"},\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-group has-border-color has-background\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;background-color:#ffffff;padding-top:20px;padding-right:20px;padding-bottom:20px;padding-left:20px\"><!-- wp:image {\"id\":65,\"aspectRatio\":\"2.25\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"style\":{\"border\":{\"radius\":\"10px\",\"width\":\"0px\"}}} -->\n<figure class=\"wp-block-image size-full has-custom-border\"><img src=\"https://primedomestic.com.au/staging/wp-content/uploads/2026/11/end-of-lease-cleaning.jpg\" alt=\"An empty home with polished floors and glass doors.\" class=\"wp-image-65\" style=\"border-wid