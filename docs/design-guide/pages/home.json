block-column\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"12px\",\"fontWeight\":\"700\",\"letterSpacing\":\"1.5px\"},\"color\":{\"text\":\"#086762\"}}} -->\n<p class=\"has-text-color\" style=\"color:#086762;font-size:12px;font-weight:700;letter-spacing:1.5px\">02</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h3 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">We confirm the details</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Send photos on WhatsApp if you like. We agree the final price and date with you.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"12px\",\"fontWeight\":\"700\",\"letterSpacing\":\"1.5px\"},\"color\":{\"text\":\"#086762\"}}} -->\n<p class=\"has-text-color\" style=\"color:#086762;font-size:12px;font-weight:700;letter-spacing:1.5px\">03</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h3 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">We clean, you relax</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Pay by bank transfer or PayID once the clean is done.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#ffffff\"},\"spacing\":{\"padding\":{\"top\":\"44px\",\"right\":\"22px\",\"bottom\":\"44px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#ffffff;margin-top:0;margin-bottom:0;padding-top:44px;padding-right:22px;padding-bottom:44px;padding-left:22px\"><!-- wp:heading {\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h2 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Local reviews</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"style\":{\"color\":{\"background\":\"#faf7ee\"},\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"20px\",\"right\":\"20px\",\"bottom\":\"20px\",\"left\":\"20px\"},\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-group has-border-color has-background\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;background-color:#faf7ee;padding-top:20px;padding-right:20px;padding-bottom:20px;padding-left:20px\"><!-- wp:heading {\"level\":3,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h3 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">What our neighbours say</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Read local customers’ reviews of Prime Domestic on Google.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"style\":{\"spacing\":{\"blockGap\":\"9px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"#ffffff\",\"text\":\"#143e40\"},\"border\":{\"radius\":\"6px\",\"width\":\"1px\",\"color\":\"#ceded8\"},\"spacing\":{\"padding\":{\"top\":\"12px\",\"right\":\"18px\",\"bottom\":\"12px\",\"left\":\"18px\"}},\"typography\":{\"fontWeight\":\"600\",\"fontSize\":\"15px\"}}} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-text-color has-background has-border-color has-custom-font-size wp-element-button\" href=\"https://www.google.com/maps/search/?api=1&amp;query=Prime+Domestic+and+Cleaning+Services&amp;query_place_id=ChIJC3EDf4Xi_WARdmtj5gvjjqg\" style=\"border-color:#ceded8;border-width:1px;border-radius:6px;color:#143e40;background-colo