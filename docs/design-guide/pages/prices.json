  "title": "Prime — Prices",
  "content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#f7faf7\"},\"spacing\":{\"padding\":{\"top\":\"44px\",\"right\":\"22px\",\"bottom\":\"44px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"},\"anchor\":\"estimate\"} -->\n<div class=\"wp-block-group alignfull has-background\" id=\"estimate\" style=\"background-color:#f7faf7;margin-top:0;margin-bottom:0;padding-top:44px;padding-right:22px;padding-bottom:44px;padding-left:22px\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"12px\",\"fontWeight\":\"700\",\"letterSpacing\":\"1.5px\"},\"color\":{\"text\":\"#086762\"}}} -->\n<p class=\"has-text-color\" style=\"color:#086762;font-size:12px;font-weight:700;letter-spacing:1.5px\">PRIME DOMESTIC / PRICES</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h1 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Prices &amp; instant estimate</h1>\n<!-- /wp:heading -->\n\n<!-- wp:columns {\"verticalAlignment\":\"top\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"16px\",\"left\":\"20px\"}}}} -->\n<div class=\"wp-block-columns are-vertically-aligned-top\"><!-- wp:column {\"width\":\"66%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:66%\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#ffffff\"},\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"20px\",\"right\":\"20px\",\"bottom\":\"20px\",\"left\":\"20px\"},\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-group has-border-color has-background\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;background-color:#ffffff;padding-top:20px;padding-right:20px;padding-bottom:20px;padding-left:20px\"><!-- wp:shortcode -->\n[fluentform title=\"Prime | Cleaning estimate · Guide\"]\n<!-- /wp:shortcode --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"34%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:34%\"><!-- wp:group {\"style\":{\"color\":{\"background\":\"#faf7ee\"},\"border\":{\"color\":\"#ceded8\",\"width\":\"1px\",\"style\":\"solid\",\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"20px\",\"right\":\"20px\",\"bottom\":\"20px\",\"left\":\"20px\"},\"blockGap\":\"12px\"}}} -->\n<div class=\"wp-block-group has-border-color has-background\" style=\"border-color:#ceded8;border-style:solid;border-width:1px;border-radius:10px;background-color:#faf7ee;padding-top:20px;padding-right:20px;padding-bottom:20px;padding-left:20px\"><!-- wp:heading {\"level\":3,\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h3 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Need a hand?</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Talk through your clean with our local team.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"style\":{\"spacing\":{\"blockGap\":\"9px\"}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"#ffffff\",\"text\":\"#143e40\"},\"border\":{\"radius\":\"6px\",\"width\":\"1px\",\"color\":\"#ceded8\"},\"spacing\":{\"padding\":{\"top\":\"12px\",\"right\":\"18px\",\"bottom\":\"12px\",\"left\":\"18px\"}},\"typography\":{\"fontWeight\":\"600\",\"fontSize\":\"15px\"}}} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-text-color has-background has-border-color has-custom-font-size wp-element-button\" href=\"https://wa.me/61491245156\" style=\"border-color:#ceded8;border-width:1px;border-radius:6px;color:#143e40;background-color:#ffffff;padding-top:12px;padding-right:18px;padding-bottom:12px;padding-left:18px;font-size:15px;font-weight:600\">WhatsApp us</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#ffffff\"},\"spacing\":{\"padding\":{\"top\":\"44px\",\"right\":\"22px\",\"bottom\":\"44px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#ffffff;margin-top:0;margin-bottom:0;padding-top:44px;padding-right:22px;padding-bottom:44px;padding-left:22px\"><!-- wp:heading {\"style\":{\"spacing\":{\"margin\":{\"top\":\"12px\",\"bottom\":\"12px\"}}}} -->\n<h2 class=\"wp-block-heading\" style=\"margin-top:12px;margin-bottom:12px\">Starting prices</h2>\n<!-- /wp:heading -->\n\n<!-- wp:table {\"style\":{\"border\":{\"color\":\"#ceded8\"},\"typography\":{\"fontSize\":\"15px\"}}} -->\n<figure style=\"font-size:15px\" class=\"wp-block-table\"><table class=\"has-border-color has-fixed-layout\" style=\"border-color:#ceded8\"><thead><tr><th>Service</th><th>How it is priced</th></tr></thead><tbody><tr><td>Regular house clean</td><td>Bedroom × bathroom grid</td></tr><tr><td>Deep / spring clean</td><td>1.5 × regular base</td></tr><tr><td>End of lease</td><td>Empty-home grid</td></tr><tr><td>Carpet steam</td><td>Per bedroom, lounge, hallway or stairs</td></tr></tbody></table></figure>\n<!-- /wp:table -->\n\n<!-- wp:paragraph -->\n<p>Minimum job $110. Where a rate is unavailable, request a custom quote.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#faf7ee\"},\"spacing\":{\"padding\":{\"top\":\"44px\",\"right\":\"22px\",\"bottom\":\"44px\",\"left\":\"22px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"22px\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1160px\"}} -->\n<div cla